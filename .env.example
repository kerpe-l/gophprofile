# Пример окружения для локального запуска. Скопировать в .env и поправить.
# Секреты (DATABASE_DSN, S3_ACCESS_KEY, S3_SECRET_KEY, AMQP_URL) значений
# по умолчанию не имеют: без них бинарник падает на старте.

# Приложение: local | production. От окружения зависит формат логов по умолчанию.
APP_ENV=local
# debug | info | warn | error
LOG_LEVEL=debug
# json | text; по умолчанию text для local и json для production
LOG_FORMAT=text

# HTTP-сервер
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
# С запасом на заливку 10 MB по медленному каналу
HTTP_READ_TIMEOUT=3m
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=2m
HTTP_SHUTDOWN_TIMEOUT=15s

# PostgreSQL
DATABASE_DSN=postgres://gophprofile:gophprofile@localhost:5432/gophprofile?sslmode=disable
DB_MAX_CONNS=10
DB_QUERY_TIMEOUT=5s

# MinIO / S3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_USE_SSL=false
S3_TIMEOUT=15s

# RabbitMQ
AMQP_URL=amqp://guest:guest@localhost:5672/
AMQP_PREFETCH=8
AMQP_TIMEOUT=10s

# Обработка изображений
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_PIXELS=50000000
IMAGE_JPEG_QUALITY=85
