# Пример окружения для локального запуска. Скопировать в .env и поправить.
# Секреты (DATABASE_DSN, S3_ACCESS_KEY, S3_SECRET_KEY, AMQP_URL) значений
# по умолчанию не имеют: без них бинарник падает на старте.
#
# Адреса здесь указывают на localhost — это набор для запуска бинарников
# напрямую, рядом с поднятой через compose инфраструктурой. Самим контейнерам
# server, worker и migrator адреса подставляет docker-compose.yml: внутри его
# сети база доступна как db, хранилище как minio, брокер как rabbitmq.

# Приложение: local | production. От окружения зависит формат логов по умолчанию.
APP_ENV=local
# debug | info | warn | error
LOG_LEVEL=debug
# json | text; по умолчанию text для local и json для production
LOG_FORMAT=text

# HTTP-сервер
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
# С запасом на заливку 10 MB по медленному каналу
HTTP_READ_TIMEOUT=3m
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=2m
HTTP_SHUTDOWN_TIMEOUT=15s

# PostgreSQL
DATABASE_DSN=postgres://gophprofile:gophprofile@localhost:5432/gophprofile?sslmode=disable
DB_MAX_CONNS=10
DB_QUERY_TIMEOUT=5s

# MinIO / S3
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=avatars
S3_USE_SSL=false
S3_TIMEOUT=15s

# RabbitMQ
AMQP_URL=amqp://guest:guest@localhost:5672/
AMQP_PREFETCH=8
AMQP_TIMEOUT=10s

# Обработка изображений
IMAGE_MAX_UPLOAD_BYTES=10485760
IMAGE_MAX_PIXELS=50000000
IMAGE_JPEG_QUALITY=85

# --- Только для docker-compose.yml ---
# Учётные данные, с которыми поднимается инфраструктура. Приложение их не
# читает: compose собирает из них DATABASE_DSN и AMQP_URL для контейнеров.
# Значения по умолчанию у compose те же, поэтому окружение поднимается и без
# этого файла.
POSTGRES_USER=gophprofile
POSTGRES_PASSWORD=gophprofile
POSTGRES_DB=gophprofile
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Порты, которые compose публикует на хост.
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
HTTP_PORT=8080
